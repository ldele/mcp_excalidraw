# Dependencies
node_modules/

# Build artifacts
dist/
public/dist/

# Environment files
.env

# Logs
*.log

# Editor artifacts
.cursor/
.agent/

# The synced copy of skills/excalidraw-skill. Source of truth is skills/;
# `npm run sync:skills` replaces this wholesale, so it is never committed.
.agents/

# Scratch drawings. Note: the fixture corpus in docs/ROADMAP.md PR 2 will need
# committed .excalidraw files, so that PR must carve out an exception here.
*.excalidraw

.DS_Store

# .claude/ and docs/ are COMMITTED: they carry the handoff baton, the canonical
# context and the roadmap, which exist precisely so another session can read
# them. Machine-local files are ignored by .claude/.gitignore instead.