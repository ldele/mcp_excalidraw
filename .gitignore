# Dependencies
node_modules/

# Build artifacts
dist/
public/dist/

# Environment files
.env

# Logs
*.log

# Editor artifacts
.cursor/
.agent/

# The synced copy of skills/excalidraw-skill. Source of truth is skills/;
# `npm run sync:skills` replaces this wholesale, so it is never committed.
.agents/

# Scratch drawings stay out of the repo...
*.excalidraw
# ...except the fixture corpus, which is the whole point of committing drawings:
# these five files are the known-good input `npm run test:corpus` reads back
# (ADR-001, docs/specs/SPEC-001-fixture-corpus.md). Carved out by PR 2, as the
# note that used to live here asked for.
!tests/fixtures/*.excalidraw

.DS_Store

# .claude/ and docs/ are COMMITTED: they carry the handoff baton, the canonical
# context and the roadmap, which exist precisely so another session can read
# them. Machine-local files are ignored by .claude/.gitignore instead.